# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Use a long, random value and keep it secret in every environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Number of days before a refresh token expires.
REFRESH_TOKEN_TTL_DAYS="30"

# Password recovery.
PASSWORD_RESET_TTL_MINUTES="15"
PASSWORD_RESET_URL="http://localhost:3000/reset-password"

# Mailtrap Email Sandbox SMTP credentials.
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="549343eb104aac"
SMTP_PASS="TU_PASSWORD_REAL_DE_MAILTRAP"
SMTP_FROM="no-reply@paint.local"

# Optional default recipient for `pnpm run email:test`.
TEST_EMAIL_TO="developer@example.com"
